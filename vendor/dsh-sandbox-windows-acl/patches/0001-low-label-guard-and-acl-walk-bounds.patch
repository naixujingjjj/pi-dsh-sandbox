+/**
+ * True when the directory ALREADY sits at Low no-write-up through an inherited
+ * label ACE — the case {@link hasExactLabel} misses, because an inherited ACE
+ * carries and-set INHERITED_ACE on top of OI|CI. Windows applies the label to
+ * both containers and objects, so such a directory needs no label write of its
+ * own; writing one anyway is what requires WRITE_OWNER (the label lives in the
+ * SACL) and fails with ERROR_ACCESS_DENIED on a directory whose DACL only
+ * grants the owner-implicit WRITE_DAC.
+ *
+ * Only the ACE flags' inheritance bits are compared (an inherited ACE keeps
+ * them); the mask must carry NO_WRITE_UP so the subtree stays no-write-up
+ * (extra policies such as no-read-up only restrict further), and the trustee
+ * must be the Low SID. A malformed header reads as "no effective label", which
+ * falls back to writing the label — the fail-closed direction.
+ * @param labelAcl - the directory's label ACL (from {@link readCurrentSecurity}).
+ * @param lowLabelSidPtr - the Low integrity SID the label must name.
+ * @returns whether the directory is already Low no-write-up by inheritance.
+ */
+function hasEffectiveLowLabel(labelAcl: NativePtr, lowLabelSidPtr: NativePtr): boolean {
+  const aclSize = decodeUint16At(labelAcl, 2)
+  const aceCount = decodeUint16At(labelAcl, 4)
+  if (aclSize < abi.ACL_HEADER_SIZE || aclSize > 1_048_576) return false // implausible: write the label
+  let offset = abi.ACL_HEADER_SIZE
+  let found = false
+  for (let index = 0; index < aceCount; index++) {
+    // ACE_HEADER: AceType@0, AceFlags@1, AceSize@2 (WORD). The 4-byte header must
+    // lie inside the ACL before any field is decoded; a truncated tail is a
+    // malformed ACL, not a label to trust.
+    if (offset + 4 > aclSize) return false // implausible: write the label
+    const aceSize = decodeUint16At(labelAcl, offset + 2)
+    if (aceSize < 4 || offset + aceSize > aclSize) return false // implausible: write the label
+    if (decodeUint8At(labelAcl, offset) === abi.SYSTEM_MANDATORY_LABEL_ACE_TYPE) {
+      // Candidate label: Mask@4 and the inline SID@8 must fit the ACE before
+      // they are read, and the SID's own header (revision@0, count@1, six
+      // authority bytes) plus its declared subauthorities must fit it before
+      // sameSidAt may walk the subauthorities.
+      if (aceSize < abi.MANDATORY_ACE_OVERHEAD + abi.MIN_SID_LENGTH) return false // implausible: write the label
+      const subAuthorities = decodeUint8At(labelAcl, offset + 9)
+      if (subAuthorities > abi.SID_MAX_SUB_AUTHORITIES) return false // implausible: write the label
+      const sidLength = abi.MIN_SID_LENGTH + subAuthorities * 4
+      if (abi.MANDATORY_ACE_OVERHEAD + sidLength > aceSize) return false // truncated SID: write the label
+      const matches = (decodeUint8At(labelAcl, offset + 1) & ~abi.INHERITED_ACE) === abi.SUB_CONTAINERS_AND_OBJECTS_INHERIT
+        && (decodeUint32At(labelAcl, offset + 4) & abi.SYSTEM_MANDATORY_LABEL_NO_WRITE_UP) !== 0
+        && sameSidAt(labelAcl, offset + 8, lowLabelSidPtr, 0)
+      // Keep walking: an early ACE must not hide later corruption, or the
+      // caller would skip the label write on a malformed descriptor.
+      if (matches) found = true
+    }
+    offset += aceSize
+  }
+  return found
+}
