{
	"name": "pi-dsh-sandbox",
	"version": "0.4.1",
	"description": "Windows write-confinement sandbox for the Pi coding agent: routes shell and file-mutation tools through the DSH Windows ACL restricted-token runner, plus a human-approved one-shot sandbox_request escape.",
	"type": "module",
	"license": "MIT",
	"private": false,
	"keywords": [
		"pi-package",
		"pi-extension",
		"sandbox",
		"windows",
		"acl",
		"restricted-token"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"files": [
		"src",
		"docs/*.md",
		"README.md",
		"CONTRIBUTING.md",
		"CHANGELOG.md",
		"LICENSE",
		"THIRD_PARTY_NOTICES.md"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --test --test-isolation=none --test-concurrency=1 test/unit/*.test.mjs",
		"test:integration": "node --test test/integration/*.test.mjs",
		"test:pi": "node scripts/smoke-pi.mjs",
		"test:register": "node scripts/smoke-register.mjs",
		"test:cli": "node scripts/smoke-cli.mjs",
		"test:failure": "node scripts/smoke-failclosed.mjs",
		"test:pack": "node scripts/check-pack.mjs",
		"verify": "npm run check:repo && npm run typecheck && npm test",
		"check:repo": "node scripts/check-repo.mjs",
		"pack": "node scripts/package.mjs",
		"check:package": "node scripts/check-package.mjs",
		"verify:windows": "npm run verify && npm run test:integration && npm run test:register && npm run test:pi && npm run test:cli && npm run test:failure && npm run test:pack"
	},
	"dependencies": {
		"@deepseek-ai/dsh-sandbox-windows-acl": "0.2.2-rc.5"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.6.0",
		"@earendil-works/pi-tui": ">=1.6.0",
		"typebox": ">=1.0.0"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.6.0",
		"@types/node": "^22.10.5",
		"typescript": "^5.7.3"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
